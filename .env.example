# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Only the PUBLISHABLE key belongs here. Never put an sb_secret_ / service_role key in the app:
# EXPO_PUBLIC_ variables are bundled into the app and readable by anyone who installs it.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Baymon API (FastAPI on Render), no trailing slash. Memory is read/written through it.
EXPO_PUBLIC_API_URL=https://your-service.onrender.com
