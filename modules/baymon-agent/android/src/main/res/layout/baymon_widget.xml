<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: one tap starts talking to Baymon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/baymon_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/baymon_widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="18dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/baymon_orb" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/baymon_widget_talk"
        android:textColor="#FFF4F3EF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
